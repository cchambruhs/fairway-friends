{
  "name": "fairway-friends",
  "version": "0.1.0",
  "private": true,
  "description": "Fairway Friends League Platform \u2014 UDisc CardCast scorecard importing, league stats and competition scoring for fairwayleagueplay.com",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "verify:fetch": "node scripts/verify-fetch.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:parser": "node --test tests/parser.test.mjs",
    "test:scoring": "node --test tests/scoring.test.mjs",
    "test:money": "node --test tests/money.test.mjs",
    "dev": "npm --prefix apps/web run dev",
    "build": "npm --prefix apps/web run build",
    "test:web": "npm --prefix apps/web test",
    "test:all": "npm test && npm run test:web"
  },
  "license": "UNLICENSED"
}
