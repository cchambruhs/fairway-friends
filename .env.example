# Fairway Friends — environment template. Copy to .env.local for local work.
# Never commit real values. Polsia injects these at deploy time; on another host
# (e.g. Vercel) set them in that host's project settings.

# --- Required -----------------------------------------------------------------
# Postgres connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fairway_friends

# Better Auth: a long random secret (e.g. `openssl rand -base64 32`) and the site URL.
BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email sending currently goes through Polsia's proxy (Phase 0 keeps it; an adapter
# for a non-Polsia provider arrives before any host move).
# Polsia supplies the real value; any valid URL works for local development (emails won't send).
POLSIA_EMAIL_PROXY_URL=https://example.invalid/email-proxy

# --- Optional -----------------------------------------------------------------
# Comma-separated extra origins allowed to call auth endpoints.
# BETTER_AUTH_TRUSTED_ORIGINS=https://fairwayleagueplay.com,https://www.fairwayleagueplay.com
# Email of the platform owner/admin account.
# POLSIA_OWNER_EMAIL=
# POLSIA_COMPANY_EMAIL=
# Google sign-in (only once configured and verified).
# POLSIA_GOOGLE_SIGNIN_CLIENT_ID=
# GOOGLE_SIGNIN_CLIENT_SECRET=
# NEXT_PUBLIC_POLSIA_GOOGLE_SIGNIN=
# NEXT_PUBLIC_GOOGLE_SIGNIN_CLIENT_ID=
# Polsia file uploads (profile photos).
# POLSIA_API_KEY=
# POLSIA_R2_BASE_URL=
# Polsia Stripe module. Payments are disabled in Fairway Friends; leave unset.
# POLSIA_API_TOKEN=

# Set to 1 to build/lint without real env values (CI only).
# SKIP_ENV_VALIDATION=1
